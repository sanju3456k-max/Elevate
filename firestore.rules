rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health/connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profile documents and all subcollections (notes, sessions, settings, htmlNotesStudio, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Chat Archives: Deprecated legacy collection. Reads, creates, and updates are forbidden. Only delete is permitted to purge old documents.
    match /chat_archives/{userId} {
      allow read, create, update: if false;
      allow delete: if isOwner(userId);
    }

    // Notes Manifests: Deprecated and disarmed (no cloud reads or writes permitted)
    match /notes_manifests/{userId} {
      allow read, write: if false;
    }

    // User Sync Beacons: Single lightweight revision tracker per user
    match /user_sync_beacons/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Math Tests: Deprecated legacy collection. Only delete is permitted for cleanup.
    match /tests/{testId} {
      allow read, create, update: if false;
      allow delete: if isSignedIn();
    }

    // Test Attempts: Deprecated legacy collection. Only delete is permitted for cleanup.
    match /attempts/{attemptId} {
      allow read, create, update: if false;
      allow delete: if isSignedIn();
    }
  }
}
