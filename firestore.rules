rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == 'sanju3456k@gmail.com';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health/connection check (Read-only ping, no writes permitted)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents and all subcollections (notes, sessions, settings, htmlNotesStudio, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Chat Archives: Deprecated legacy collection. Reads, creates, and updates are forbidden. Only delete is permitted to purge old documents.
    match /chat_archives/{userId} {
      allow read, create, update: if false;
      allow delete: if isOwner(userId);
    }

    // Notes Manifests: Deprecated and disarmed (no cloud reads or writes permitted)
    match /notes_manifests/{userId} {
      allow read, write: if false;
    }

    // User Sync Beacons: Single lightweight revision tracker per user
    match /user_sync_beacons/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Test Leaderboards: Lightweight rankings per test
    // 1. Top Bucket Document: Single document containing top 100 students (1 Read for everyone)
    match /test_leaderboards/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /test_leaderboards/{testId}/summary/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 2. Individual user entries (1 doc per user)
    match /test_leaderboards/{testId}/entries/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isMasterAdmin();
    }

    // Master Published Tests: Official papers curated and published by Master Academic Head
    // Public read: All users (guests and signed in students) can view and take tests
    // Write: Strictly restricted to Master Enterprise Account (sanju3456k@gmail.com)
    match /published_tests/{testId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /master_catalog/{docId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Personalized Remedial Assignments:
    // Read: Master or the recipient student
    // Write: Master can create/delete; assigned student can update their completion status
    match /remedial_assignments/{assignmentId} {
      allow read: if isSignedIn() && (isMasterAdmin() || resource.data.studentId == request.auth.uid || (resource.data.studentEmail != null && resource.data.studentEmail == request.auth.token.email));
      allow create, delete: if isMasterAdmin();
      allow update: if isSignedIn() && (isMasterAdmin() || resource.data.studentId == request.auth.uid);
    }

    // Math Tests: Deprecated legacy collection. Only owner delete is permitted for cleanup.
    match /tests/{testId} {
      allow read, create, update: if false;
      allow delete: if isSignedIn() && (resource == null || resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Test Attempts: Deprecated legacy collection. Only owner delete is permitted for cleanup.
    match /attempts/{attemptId} {
      allow read, create, update: if false;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
